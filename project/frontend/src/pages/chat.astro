---
import Layout from "@layouts/global.astro";
import { Authentication, User, UserFilter } from "shared/models";
import { UserRole, type IUser } from "shared/schema";

const token = Authentication.validateToken(Astro.request);
if (!token) return Astro.redirect("/auth/login");

const user = token ? await User.read(token.sub, UserFilter.Id) : null;
if (!user) return Astro.redirect("/auth/login");
---

<Layout title="Chat" user={user}>
    <div class="chat-page">
        <div class="chat-sidebar" id="chat-sidebar">
            <h2>Messages</h2>
            <div id="conversation-list">
                <p class="loading">Loading conversations...</p>
            </div>
        </div>
        <div class="chat-main" id="chat-main">
            <div class="chat-empty">
                <iconify-icon icon="mdi:message-text-outline" width="64" height="64"></iconify-icon>
                <p>Select a conversation to start messaging</p>
            </div>
        </div>
    </div>

    <script>
        async function loadConversations() {
            const list = document.getElementById("conversation-list");
            if (!list) return;

            try {
                const res = await fetch("/api/v1/messages");
                const data = await res.json();

                if (!data.success || !data.conversations || data.conversations.length === 0) {
                    list.innerHTML = '<p class="empty">No conversations yet</p>';
                    return;
                }

                list.innerHTML = data.conversations.map((c: any) => `
                    <button class="conv-item" data-partner-id="${c.partner.id}" data-handle="${escapeHtml(c.partner.handle)}">
                        <img src="${c.partner.avatarUrl || '/images/avatar/default.png'}" alt="" class="avatar" />
                        <div class="conv-info">
                            <strong>${escapeHtml(c.partner.displayName || c.partner.handle)}</strong>
                            <p>${escapeHtml(c.lastMessage.content)}</p>
                        </div>
                    </button>
                `).join("");

                list.querySelectorAll(".conv-item").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const partnerId = (btn as HTMLElement).dataset.partnerId || "";
                        const handle = (btn as HTMLElement).dataset.handle || "";
                        loadConversation(partnerId, handle);
                    });
                });
            } catch {
                list.innerHTML = '<p class="error">Failed to load conversations</p>';
            }
        }

        async function loadConversation(partnerId: string, handle: string) {
            const main = document.getElementById("chat-main");
            if (!main) return;

            try {
                const res = await fetch(`/api/v1/messages?user=${partnerId}`);
                const data = await res.json();

                if (!data.success) {
                    main.innerHTML = '<p class="error">Failed to load messages</p>';
                    return;
                }

                const msgs = data.messages || [];
                main.innerHTML = `
                    <div class="chat-header-bar">
                        <h3>@${escapeHtml(handle)}</h3>
                    </div>
                    <div class="message-list">
                        ${msgs.map((m: any) => `
                            <div class="msg ${m.senderId === partnerId ? 'received' : 'sent'}">
                                ${m.senderId !== partnerId ? '' : `<span class="sender">@${escapeHtml(m.sender?.handle || handle)}</span>`}
                                <p>${escapeHtml(m.content)}</p>
                                <span class="time">${new Date(m.createdAt).toLocaleTimeString()}</span>
                            </div>
                        `).join("")}
                    </div>
                    <form class="send-form" id="send-form">
                        <input type="text" id="msg-input" placeholder="Type a message..." maxlength="1000" />
                        <button type="submit">Send</button>
                    </form>
                `;

                // Scroll to bottom
                const ml = main.querySelector(".message-list");
                if (ml) ml.scrollTop = ml.scrollHeight;

                // Wire up send
                const form = document.getElementById("send-form");
                form?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const input = document.getElementById("msg-input") as HTMLInputElement;
                    if (!input?.value.trim()) return;

                    await fetch("/api/v1/contact/host", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ hostId: partnerId, message: input.value.trim() }),
                    });

                    input.value = "";
                    loadConversation(partnerId, handle);
                });
            } catch {
                main.innerHTML = '<p class="error">Failed to load messages</p>';
            }
        }

        function escapeHtml(text: string): string {
            const div = document.createElement("div");
            div.textContent = text;
            return div.innerHTML;
        }

        loadConversations();
    </script>

    <style lang="scss">
        .chat-page {
            display: flex;
            height: calc(100vh - 5rem);
            max-width: 1200px;
            margin: 0 auto;
        }

        .chat-sidebar {
            width: 320px;
            border-right: 1px solid var(--accent-3);
            overflow-y: auto;
            padding: 1rem;

            h2 { margin: 0 0 1rem; }
        }

        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .conv-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem;
            width: 100%;
            background: none;
            border: none;
            border-bottom: 1px solid var(--accent-3);
            cursor: pointer;
            text-align: left;
            color: var(--foreground);

            &:hover { background: rgba(0, 0, 0, 0.03); }

            .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }

            .conv-info {
                flex: 1;
                min-width: 0;

                strong { display: block; font-size: 0.9rem; }
                p { margin: 0.2rem 0 0; font-size: 0.8rem; color: var(--text-muted);
                    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            }
        }

        .chat-header-bar {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--accent-3);
            background: var(--card-bg);
            h3 { margin: 0; }
        }

        .message-list {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .msg {
            max-width: 70%;
            margin-bottom: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: 12px;
            font-size: 0.9rem;

            &.sent {
                margin-left: auto;
                background: var(--accent-1);
                color: white;
            }

            &.received {
                background: var(--accent-3);
            }

            .sender { font-size: 0.75rem; color: var(--text-muted); }
            .time { font-size: 0.7rem; color: var(--text-muted); }

            p { margin: 0.2rem 0 0; word-wrap: break-word; }
        }

        .send-form {
            display: flex;
            gap: 0.5rem;
            padding: 0.75rem;
            border-top: 1px solid var(--accent-3);

            input {
                flex: 1;
                padding: 0.5rem 0.75rem;
                border: 1px solid var(--accent-3);
                border-radius: 8px;
                background: var(--background);
                color: var(--foreground);
            }

            button {
                background: var(--accent-1);
                color: white;
                border: none;
                border-radius: 8px;
                padding: 0.5rem 1rem;
                cursor: pointer;
            }
        }

        .chat-empty, .loading, .empty, .error {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            color: var(--text-muted);
            text-align: center;
            padding: 2rem;
        }

        .error { color: var(--base-red); }

        @media (max-width: 768px) {
            .chat-page { flex-direction: column; }
            .chat-sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--accent-3);
                max-height: 40vh;
            }
        }
    </style>
</Layout>