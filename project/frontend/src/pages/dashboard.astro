---
import Layout from "@layouts/global.astro";
import Button from "@components/base/Button.svelte";
import Card from "@components/base/Card.svelte";
import SessionCard from "@components/cards/SessionCard.svelte";
import SearchBar from "@components/base/SearchBar.svelte";
import { Icon } from "astro-iconify";

import { Authentication } from "shared/models";
import { db } from "shared/helpers";
import { categories } from "@lib/categories";

const token = Authentication.validateToken(Astro.request);
if (!token) return Astro.redirect("/auth/login");

const currentUser = await db.user.findUnique({ where: { id: token.sub }, select: { role: true } });
const isDemo = currentUser?.role === "DEMO";

const sessions = await db.session.findMany({
    where: {
        OR: [{ userId: token.sub }, { registrations: { some: { userId: token.sub } } }],
    },
    orderBy: { eventDate: "asc" },
});

const mySessions = sessions.map((s) => ({
    id: s.id,
    title: s.name,
    zoomLink: s.meetingUrl || "",
    time: s.eventDate.toLocaleString("en-US", {
        weekday: "short",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "numeric",
    }),
    status: s.eventDate > new Date() ? "Upcoming" : "Past",
    details: s.description || "",
    isHost: s.userId === token.sub,
}));

const reviews = await db.review.findMany({
    where: {
        recipientId: token.sub,
        rating: { gt: 0 },
    },
    include: {
        author: {
            include: {
                profile: true,
            },
        },
        session: true,
    },
    orderBy: { createdAt: "desc" },
});

const messages = await db.message.findMany({
    where: {
        recipientId: token.sub,
    },
    include: {
        sender: {
            include: {
                profile: true,
            },
        },
    },
    orderBy: { createdAt: "desc" },
});

const allTopics = categories;
// Deterministic shuffle seeded by day so it changes daily but not per-request
const daySeed = new Date().toISOString().slice(0, 10);
const suggestedTopics = [...allTopics].sort((a, b) => {
    const ha = (daySeed + a.title).split("").reduce((s, c) => s + c.charCodeAt(0), 0);
    const hb = (daySeed + b.title).split("").reduce((s, c) => s + c.charCodeAt(0), 0);
    return ha - hb;
}).slice(0, 4);
---

<Layout title="Dashboard">
    <div class="dashboard-container">
        <header class="welcome-header">
            <h1>Welcome back!</h1>
            <p>Here's what's happening in your learning journey.</p>
        </header>

        <section class="teacher-dashboard">
            <Card class="dashboard-card full-width">
                <div class="card-header">
                    <h2>Your Sessions</h2>
                    {!isDemo && <Button size="sm" href="/session/create"> Create New Session </Button>}
                </div>
                <div class="teaching-list">
                    {
                        mySessions.map((session) => (
                            <div class="session-item-detailed">
                                <div class="session-main">
                                    <div class="session-header">
                                        <h3>{session.title}</h3>
                                        <span class={`status-badge ${session.status.toLowerCase()}`}>
                                            {session.status}
                                        </span>
                                    </div>
                                    <div class="session-details">
                                        {session.zoomLink && (
                                            <a href={session.zoomLink} target="_blank" class="detail-item zoom-link">
                                                <Icon name="mdi:video-outline" width={16} height={16} aria-label="Zoom Link" />
                                                Zoom Link
                                            </a>
                                        )}
                                        <span class="detail-item">
                                            <Icon name="mdi:clock-outline" width={16} height={16} aria-label="Time" />
                                            {session.time}
                                        </span>
                                    </div>
                                    <p class="notes">{session.details}</p>
                                </div>
                                <div class="session-actions">
                                    {!isDemo && session.isHost && (
                                        <Button size="sm" variant="outline" href={`/session/${session.id}/edit`}>
                                            Edit
                                        </Button>
                                    )}
                                    {!isDemo && (
                                    <Button
                                        size="sm"
                                        variant="ghost"
                                        class="text-danger btn-cancel-session"
                                        data-id={session.id}
                                        data-is-host={session.isHost.toString()}
                                    >
                                        {session.isHost ? "Cancel" : "Leave"}
                                    </Button>
                                    )}
                                </div>
                            </div>
                        ))
                    }
                    {
                        mySessions.length === 0 && (
                            <div class="empty-state">
                                <p>You haven't created any sessions yet.</p>
                            </div>
                        )
                    }
                </div>
            </Card>
        </section>

        {
            messages.length > 0 && (
                <section class="reviews-section">
                    <div class="section-header">
                        <h2>Messages</h2>
                    </div>

                    <div class="reviews-grid">
                        {messages.map((message) => (
                            <Card class="review-card message-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <img
                                            src={
                                                message.sender.profile?.avatarUrl ||
                                                "https://ui-avatars.com/api/?name=" + message.sender.handle
                                            }
                                            alt={message.sender.profile?.displayName}
                                            aria-label={message.sender.profile?.displayName}
                                            class="avatar"
                                        />
                                        <div>
                                            <span class="name">
                                                {message.sender.profile?.displayName || message.sender.handle}
                                            </span>
                                            <div class="meta-info">
                                                <span>Message</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="review-date">
                                        {message.createdAt.toLocaleDateString()}
                                        <button
                                            class="btn-delete-message"
                                            data-id={message.id}
                                            aria-label="Delete message">
                                            <Icon name="material-symbols:close" width={16} height={16} aria-label="Delete" />
                                        </button>
                                    </div>
                                </div>

                                <div class="review-content">
                                    <p>"{message.content}"</p>
                                </div>

                                {message.sessionName && (
                                    <div class="review-footer">
                                        <small> regarding: {message.sessionName}</small>
                                    </div>
                                )}
                            </Card>
                        ))}
                    </div>
                </section>
            )
        }

        {
            reviews.length > 0 && (
                <section class="reviews-section">
                    <div class="section-header">
                        <h2>Student Ratings</h2>
                    </div>

                    <div class="reviews-grid">
                        {reviews.map((review) => (
                            <Card class="review-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <img
                                            src={
                                                review.author.profile?.avatarUrl ||
                                                "https://ui-avatars.com/api/?name=" + review.author.handle
                                            }
                                            alt={review.author.profile?.displayName}
                                            aria-label={review.author.profile?.displayName}
                                            class="avatar"
                                        />
                                        <div>
                                            <span class="name">
                                                {review.author.profile?.displayName || review.author.handle}
                                            </span>
                                            <div class="stars">
                                                {Array.from({ length: 5 }).map((_, i) => (
                                                    <Icon
                                                        name={
                                                            i < review.rating
                                                                ? "material-symbols:star"
                                                                : "material-symbols:star-outline"
                                                        }
                                                        aria-label="Star"
                                                        style={{ color: "var(--base-yellow)" }}
                                                    />
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="review-date">
                                        {review.createdAt.toLocaleDateString()}
                                        <button
                                            class="btn-delete-review"
                                            data-id={review.id}
                                            aria-label="Hide rating"
                                            title="Hide this rating"
                                        >
                                            <Icon
                                                name="material-symbols:visibility-off-outline"
                                                aria-label="Hide rating"
                                                width={16}
                                                height={16}
                                            />
                                        </button>
                                    </div>
                                </div>

                                <div class="review-content">
                                    <p>"{review.comment}"</p>
                                </div>

                                {review.session && (
                                    <div class="review-footer">
                                        <small>Session: {review.session.name}</small>
                                    </div>
                                )}
                            </Card>
                        ))}
                    </div>
                </section>
            )
        }

        <section class="discover-section">
            <div class="section-header">
                <h2>Discover New Skills</h2>
            </div>

            <Card class="search-card">
                <SearchBar placeholder="Find a skill (e.g., 'Guitar', 'Python', 'Cooking')...">
                    <div class="vertical-divider"></div>
                    <Button variant="primary">Search</Button>
                </SearchBar>
            </Card>

            <div class="discover-layout" id="discover-layout">
                <div class="filler-content">
                    <div class="ideas-section">
                        <h3>Need Some Ideas?</h3>
                        <div class="categories-grid">
                            {
                                suggestedTopics.map((topic) => (
                                    <Card class="category-card">
                                        <span class="icon">{topic.icon}</span>
                                        <h3>{topic.title}</h3>
                                        <p>{topic.description}</p>
                                    </Card>
                                ))
                            }
                        </div>
                    </div>

                    {!isDemo && (
                    <div class="promo-banner">
                        <div class="banner-content">
                            <h3>Ready to share your skills?</h3>
                            <p>Create a session today and start teaching your passion to others in the community.</p>
                        </div>
                        <Button href="/session/create" variant="primary">Start Teaching</Button>
                    </div>
                    )}
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    // SearchBar form already has action="/search" and name="q",
    // so native form submission works. This handler ensures the
    // search navigates even if JS interception is needed.
</script>

<style lang="scss">
