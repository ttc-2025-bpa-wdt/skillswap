---
import { SITE_TITLE } from "shared/config";
import AchievementGrid from "@components/achievements/AchievementGrid.svelte";
import Layout from "@layouts/global.astro";

import { Authentication, User, UserFilter } from "shared/models";
import type { IUser } from "shared/schema";

const token = Authentication.validateToken(Astro.request);
const user = token ? await User.read(token.sub, UserFilter.Id) : null;

if (!user) {
    return Astro.redirect("/auth/login");
}

const pageTitle = "Achievements";
---

<Layout title={pageTitle} user={user}>
    <main class="achievements-page">
        <header class="page-header">
            <h1>Your Achievements</h1>
            <p class="subtitle">Track your progress and earn badges</p>
        </header>

        <section class="achievements-section">
            {user && <AchievementGrid userId={user.id} client:load />}
        </section>

        <section class="leaderboard-section">
            <h2>Leaderboard</h2>
            <div id="leaderboard-container">
                <p class="loading">Loading leaderboard...</p>
            </div>
        </section>

    <script>
        async function loadLeaderboard() {
            const container = document.getElementById("leaderboard-container");
            if (!container) return;

            try {
                const res = await fetch("/api/v1/leaderboard?limit=10");
                const data = await res.json();

                if (!data.success || !data.leaderboard || data.leaderboard.length === 0) {
                    container.innerHTML = '<p class="empty">No rankings yet. Be the first to earn achievements!</p>';
                    return;
                }

                container.innerHTML = `
                    <table class="leaderboard-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>User</th>
                                <th>Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${data.leaderboard.map((entry: any, i: number) => `
                                <tr>
                                    <td class="rank ${i === 0 ? 'first' : i === 1 ? 'second' : i === 2 ? 'third' : ''}">${entry.rank}</td>
                                    <td class="user">
                                        <a href="/profile/${entry.handle}">
                                            <img src="${entry.avatarUrl || '/images/avatar/default.png'}" alt="" class="avatar" />
                                            <span>${escapeHtml(entry.displayName)}</span>
                                            <small>@${escapeHtml(entry.handle)}</small>
                                        </a>
                                    </td>
                                    <td class="points">${entry.achievementPoints}</td>
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                `;
            } catch {
                container.innerHTML = '<p class="error">Failed to load leaderboard.</p>';
            }
        }

        function escapeHtml(text: string): string {
            const div = document.createElement("div");
            div.textContent = text;
            return div.innerHTML;
        }

        loadLeaderboard();
    </script>
    </main>
</Layout>

<style lang="scss">
    .achievements-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;

        @media (max-width: 768px) {
            padding: 1rem;
        }
    }

    .page-header {
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;

            @media (max-width: 768px) {
                font-size: 2rem;
            }
        }

        .subtitle {
            font-size: 1.1rem;
            color: var(--text-muted);
        }
    }

    .achievements-section {
        margin-bottom: 3rem;
    }

    .leaderboard-section {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 2rem;
        border: 1px solid var(--accent-3);

        h2 {
            margin-bottom: 1rem;
            text-align: center;
        }

        .loading, .empty, .error {
            text-align: center;
            padding: 2rem;
            color: var(--text-muted);
        }

        .error {
            color: var(--base-red);
        }
    }

    .leaderboard-table {
        width: 100%;
        border-collapse: collapse;

        th {
            text-align: left;
            padding: 0.75rem;
            border-bottom: 2px solid var(--accent-3);
            font-size: 0.85rem;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--accent-3);
        }

        .rank {
            font-weight: 700;
            font-size: 1.1rem;
            width: 60px;

            &.first { color: #FFD700; }
            &.second { color: #C0C0C0; }
            &.third { color: #CD7F32; }
        }

        .user a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: var(--foreground);

            small {
                color: var(--text-muted);
            }

            .avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
            }
        }

        .points {
            font-weight: 600;
            color: var(--accent-1);
        }
    }

    @media (max-width: 600px) {
        .leaderboard-table .user a span {
            display: none;
        }
    }
</style>