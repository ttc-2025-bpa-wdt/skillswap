---
import Layout from "@layouts/global.astro";
---

<Layout title="Verifying Email">
    <div class="verify-page">
        <div class="verify-card">
            <div id="verify-status">
                <div class="spinner"></div>
                <p>Verifying your email address...</p>
            </div>
        </div>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const token = params.get("token");
        const statusEl = document.getElementById("verify-status");

        if (token) {
            // Attempt to verify the token with the backend
            fetch(`/api/v1/auth/verify-email?token=${encodeURIComponent(token)}`)
                .then(async (res) => {
                    if (res.ok) {
                        if (statusEl) {
                            statusEl.innerHTML = `
                                <iconify-icon icon="mdi:check-circle" width="48" height="48" style="color: #10b981;"></iconify-icon>
                                <h2>Email Verified!</h2>
                                <p>Your email has been verified successfully.</p>
                                <a href="/dashboard" class="btn">Go to Dashboard</a>
                            `;
                        }
                    } else {
                        if (statusEl) {
                            statusEl.innerHTML = `
                                <iconify-icon icon="mdi:alert-circle" width="48" height="48" style="color: var(--base-red);"></iconify-icon>
                                <h2>Verification Failed</h2>
                                <p>This link may have expired. Please request a new one.</p>
                                <a href="/auth/login" class="btn">Back to Login</a>
                            `;
                        }
                    }
                })
                .catch(() => {
                    if (statusEl) {
                        statusEl.innerHTML = `
                            <iconify-icon icon="mdi:alert-circle" width="48" height="48" style="color: var(--base-red);"></iconify-icon>
                            <h2>Verification Failed</h2>
                            <p>Something went wrong. Please try again later.</p>
                            <a href="/auth/login" class="btn">Back to Login</a>
                        `;
                    }
                });
        } else {
            if (statusEl) {
                statusEl.innerHTML = `
                    <iconify-icon icon="mdi:alert-circle" width="48" height="48" style="color: var(--base-red);"></iconify-icon>
                    <h2>Invalid Link</h2>
                    <p>This verification link is invalid or has expired.</p>
                    <a href="/auth/login" class="btn">Back to Login</a>
                `;
            }
        }
    </script>

    <style lang="scss">
        .verify-page {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 60vh;
            padding: 2rem;
        }

        .verify-card {
            background: var(--card-bg);
            border: 1px solid var(--accent-3);
            border-radius: 12px;
            padding: 3rem;
            text-align: center;
            max-width: 400px;
            width: 100%;
        }

        #verify-status {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;

            h2 { margin: 0; }
            p { color: var(--text-muted); }

            .btn {
                display: inline-block;
                padding: 0.5rem 1.5rem;
                background: var(--accent-1);
                color: white;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 500;
                margin-top: 0.5rem;

                &:hover { opacity: 0.9; }
            }
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--accent-3);
            border-top-color: var(--accent-1);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</Layout>