---
import Layout from "@layouts/global.astro";
---

<Layout title="Forgot Password">
    <div class="auth-page">
        <div class="auth-card">
            <h1>Reset Password</h1>
            <p class="subtitle">Enter your email to receive a reset link</p>

            <form id="forgot-form">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required placeholder="your@email.com" disabled />
                </div>
                <button type="submit" class="submit-btn" disabled>Coming Soon</button>
                <p class="coming-soon-note">Password reset is not yet available. Please contact an administrator.</p>
            </form>

            <div id="status-msg"></div>

            <p class="alt-link">
                <a href="/auth/login">Back to Login</a>
            </p>
        </div>
    </div>

    <script>
        document.getElementById("forgot-form")?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const statusMsg = document.getElementById("status-msg");
            if (!statusMsg) return;

            const email = (document.getElementById("email") as HTMLInputElement)?.value;
            if (!email) return;

            statusMsg.innerHTML = '<p class="info">If an account with that email exists, a reset link has been sent.</p>';

            // Backend endpoint for forgot-password doesn't exist yet,
            // so we just show the confirmation message
        });
    </script>

    <style lang="scss">
        .auth-page {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 60vh;
            padding: 2rem;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--accent-3);
            border-radius: 12px;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;

            h1 { text-align: center; margin-bottom: 0.5rem; }
            .subtitle { text-align: center; color: var(--text-muted); margin-bottom: 1.5rem; }
        }

        .form-group {
            margin-bottom: 1rem;

            label {
                display: block;
                margin-bottom: 0.25rem;
                font-weight: 500;
                font-size: 0.9rem;
            }

            input {
                width: 100%;
                padding: 0.6rem 0.75rem;
                border: 1px solid var(--accent-3);
                border-radius: 8px;
                font-size: 0.95rem;
                background: var(--background);
                color: var(--foreground);
                box-sizing: border-box;

                &:focus { outline: none; border-color: var(--accent-1); }
            }
        }

        .submit-btn {
            width: 100%;
            padding: 0.7rem;
            background: var(--accent-1);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 0.5rem;

            &:hover { opacity: 0.9; }
        }

        #status-msg {
            .info {
                text-align: center;
                padding: 1rem;
                background: rgba(44, 116, 196, 0.1);
                border-radius: 8px;
                margin-top: 1rem;
                font-size: 0.9rem;
            }
        }

        .coming-soon-note {
                text-align: center;
                font-size: 0.85rem;
                color: var(--text-muted);
                margin-top: 0.75rem;
            }

        .alt-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.9rem;

            a { color: var(--accent-1); text-decoration: none; &:hover { text-decoration: underline; } }
        }
    </style>
</Layout>